+            const Vector3r rotor_normal(0.0f, 0.0f, -1.0f);
+            const real_T rotor_z = -0.0519852106f;
+            params.rotor_poses.clear();
+            // ArduPilot Quad-X order in body FRD: FR, RL, FL, RR.
+            params.rotor_poses.emplace_back(
+                Vector3r(0.1333257042f, 0.1718964254f, rotor_z), rotor_normal,
