+            // Values are generated from Icarus's versioned component manifest.
+            // They remain design targets until replaced by as-built measurements.
+            params.rotor_count = 4;
+            params.mass = 4.4745f;
+            params.body_box = Vector3r(0.228f, 0.180f, 0.140f);
+
+            // Hobbywing XRotor 3115 / HQ 10x4.5x3 frozen simulation baseline.
+            // CT matches 4.648 kgf at 15,606 RPM. CP preserves the Gazebo
+            // moment/thrust ratio of 0.016 m.
+            params.rotor_params.C_T = 0.1321402534f;
+            params.rotor_params.C_P = 0.0522999495f;
+            params.rotor_params.max_rpm = 15606.0f;
+            params.rotor_params.propeller_diameter = 0.254f;
+            params.rotor_params.propeller_height = 0.004f;
+            params.rotor_params.control_signal_filter_tc = 0.005f;
+            params.rotor_params.calculateMaxThrust();
