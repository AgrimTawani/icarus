<?xml version="1.0"?>
<sdf version="1.9">
  <model name="icarus_mark4_v2_10" canonical_link="base_link">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <!-- FRD-oriented IMU measurement, as expected by the ArduPilot JSON
           bridge. The underlying link stays FLU. IMU adds no duplicate mass. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 -0.04 3.141592653589793 0 0</pose>
        <always_on>true</always_on><update_rate>1000</update_rate>
      </sensor>
      <!--
        Residual body inertia: the four 20 g rotating propeller disks have
        been subtracted from the Phase 3.1 aggregate with the parallel-axis
        theorem. Whole-vehicle mass, CG and inertia remain 4.343 kg,
        (0,0,-0.04) m and diag(0.0303,0.0365,0.0424) kg m^2.
        All 125 g motor allocations remain in base_link. Rotor links carry
        only the propeller masses. These are provisional simulation values.
      -->
      <inertial>
        <pose>0 0 -0.04075064508562046 0 0 0</pose>
        <mass>4.263</mass>
        <inertia>
          <ixx>0.028023662663726013</ixx>
          <iyy>0.034223662663726014</iyy>
          <izz>0.038108129456</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Reinforced 427 mm diagonal X arms. -->
      <collision name="arm_nw_se_collision">
        <pose>0 0 0 0 0 0.7853981634</pose>
        <geometry><box><size>0.427 0.024 0.007</size></box></geometry>
      </collision>
      <visual name="arm_nw_se_visual">
        <pose>0 0 0 0 0 0.7853981634</pose>
        <geometry><box><size>0.427 0.024 0.007</size></box></geometry>
        <material><diffuse>0.07 0.07 0.08 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
      <collision name="arm_ne_sw_collision">
        <pose>0 0 0 0 0 -0.7853981634</pose>
        <geometry><box><size>0.427 0.024 0.007</size></box></geometry>
      </collision>
      <visual name="arm_ne_sw_visual">
        <pose>0 0 0 0 0 -0.7853981634</pose>
        <geometry><box><size>0.427 0.024 0.007</size></box></geometry>
        <material><diffuse>0.07 0.07 0.08 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>

      <!-- Custom lower structure, avionics shelf, and representative payload. -->
      <collision name="lower_plate_collision">
        <pose>0 0 -0.045 0 0 0</pose>
        <geometry><box><size>0.200 0.110 0.008</size></box></geometry>
      </collision>
      <visual name="lower_plate_visual">
        <pose>0 0 -0.045 0 0 0</pose>
        <geometry><box><size>0.200 0.110 0.008</size></box></geometry>
        <material><diffuse>0.10 0.10 0.11 1</diffuse></material>
      </visual>
      <collision name="avionics_bay_collision">
        <pose>-0.005 0 -0.018 0 0 0</pose>
        <geometry><box><size>0.150 0.100 0.040</size></box></geometry>
      </collision>
      <visual name="avionics_bay_visual">
        <pose>-0.005 0 -0.018 0 0 0</pose>
        <geometry><box><size>0.150 0.100 0.040</size></box></geometry>
        <material><diffuse>0.15 0.18 0.20 1</diffuse></material>
      </visual>
      <collision name="battery_collision">
        <pose>0 0 -0.090 0 0 0</pose>
        <geometry><box><size>0.180 0.075 0.055</size></box></geometry>
      </collision>
      <visual name="battery_visual">
        <pose>0 0 -0.090 0 0 0</pose>
        <geometry><box><size>0.180 0.075 0.055</size></box></geometry>
        <material><diffuse>0.12 0.20 0.48 1</diffuse></material>
      </visual>

      <!-- Two skids keep the battery clear of the ground during drop tests. -->
      <collision name="left_skid_collision">
        <pose>0 0.065 -0.150 0 0 0</pose>
        <geometry><box><size>0.230 0.012 0.012</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="left_skid_visual">
        <pose>0 0.065 -0.150 0 0 0</pose>
        <geometry><box><size>0.230 0.012 0.012</size></box></geometry>
        <material><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
      <collision name="right_skid_collision">
