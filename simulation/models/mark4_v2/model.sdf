    </link>

    <link name="motor_01">
      <pose>0.15097 -0.15097 0 0 0 0</pose>
      <inertial>
        <mass>0.020</mass>
        <inertia><ixx>0.00008064500000000001</ixx><iyy>0.00008064500000000001</iyy><izz>0.00016129000000000002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- Axisymmetric disk inertia approximates the spinning 20 g propeller.
           Visual blades have no collision; blade contact is not simulated yet. -->
      <visual name="hub"><geometry><cylinder><radius>0.018</radius><length>0.020</length></cylinder></geometry>
        <material><diffuse>0.25 0.25 0.3 1</diffuse></material></visual>
      <visual name="blade_0">
        <pose>0.0635 0 0.012 0 0 0</pose>
