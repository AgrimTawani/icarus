        <geometry><box><size>0.012 0.012 0.110</size></box></geometry>
        <material><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
      <collision name="rear_left_leg_collision">
        <pose>-0.075 0.065 -0.092 0 0 0</pose>
        <geometry><box><size>0.012 0.012 0.110</size></box></geometry>
      </collision>
      <visual name="rear_left_leg_visual">
