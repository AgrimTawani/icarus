+  // Optional authoritative physical battery. Missing/stale samples must not
+  // silently fall back to SITL's unrelated nominal battery.
+  public: bool batteryConfigured{false};
+  public: gz::msgs::BatteryState batteryMsg;
+  public: bool batteryValid{false};
+  public: std::mutex batteryMutex;
+  public: void BatteryCb(const gz::msgs::BatteryState &_msg)
+  {
+    std::lock_guard<std::mutex> lock(this->batteryMutex);
+    batteryMsg = _msg;
+    batteryValid = std::isfinite(_msg.voltage()) && _msg.voltage() >= 0 &&
+      std::isfinite(_msg.current());
+  }
