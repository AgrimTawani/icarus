+    if (this->dataPtr->batteryConfigured)
+    {
+      std::lock_guard<std::mutex> lock(this->dataPtr->batteryMutex);
+      const auto &battery = this->dataPtr->batteryMsg;
+      const double stamp = battery.header().stamp().sec() +
+        battery.header().stamp().nsec() * 1e-9;
+      const bool fresh = this->dataPtr->batteryValid &&
+        timestamp >= stamp && timestamp - stamp <= 2.0;
+      writer.Key("battery");
+      writer.StartObject();
+      writer.Key("voltage");
+      writer.Double(fresh ? battery.voltage() : 0.0);
+      writer.Key("current");
+      // LinearBatteryPlugin defaults to positive discharge current.
+      writer.Double(fresh ? battery.current() : 0.0);
+      writer.EndObject();
+    }
