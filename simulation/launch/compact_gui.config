<dialog name="quick_start" show_again="false" />

<window><width>1400</width><height>900</height><menus><drawer default="false" /></menus><dialog_on_exit>false</dialog_on_exit></window>

<plugin filename="MinimalScene" name="3D View">
 <gz-gui><title>Icarus compact — live SITL flight</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
 <engine>ogre2</engine><scene>scene</scene><ambient_light>0.65 0.65 0.65</ambient_light>
 <background_color>0.55 0.66 0.76</background_color><camera_pose>3 -4 2.5 0 0.12 2.2143</camera_pose>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>

<plugin filename="CameraTracking" name="Camera Tracking"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>

<plugin filename="EntityContextMenuPlugin" name="Entity context menu"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>

<plugin filename="WorldStats" name="World stats"><gz-gui><title>Simulation clock</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="width">290</property><property type="double" key="height">110</property><anchors target="3D View"><line own="right" target="right" /><line own="bottom" target="bottom" /></anchors></gz-gui><sim_time>true</sim_time><real_time_factor>true</real_time_factor></plugin>

<plugin filename="WorldControl" name="World control"><gz-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="width">200</property><property type="double" key="height">72</property><anchors target="3D View"><line own="left" target="left" /><line own="bottom" target="bottom" /></anchors></gz-gui><play_pause>true</play_pause><step>true</step><use_event>true</use_event></plugin>
