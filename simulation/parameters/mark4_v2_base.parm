# Mark4 427 mm / 4.343 kg provisional simulation profile, fresh EEPROM each run.
FRAME_CLASS 1
FRAME_TYPE 1
AHRS_EKF_TYPE 3
EK3_ENABLE 1
ARMING_SKIPCHK 0
# Single physical sensor model: override ideal upstream SITL test defaults.
SIM_BARO_RND 0.20
SIM_BARO_DRIFT 0.002
SIM_GPS1_NOISE 0.30
SIM_MAG_RND 3.0
MOT_PWM_MIN 1000
MOT_PWM_MAX 2000
MOT_SPIN_ARM 0.05
MOT_SPIN_MIN 0.10
MOT_SPIN_MAX 0.70
MOT_THST_EXPO 0.65
MOT_THST_HOVER 0.40
MOT_HOVER_LEARN 2
# Initial conservative gains; validate for this model rather than copying Iris.
ATC_RAT_RLL_P 0.10
ATC_RAT_RLL_I 0.10
ATC_RAT_RLL_D 0.003
ATC_RAT_PIT_P 0.10
ATC_RAT_PIT_I 0.10
ATC_RAT_PIT_D 0.003
ATC_RAT_YAW_P 0.15
ATC_RAT_YAW_I 0.015
ATC_ANG_RLL_P 3.5
ATC_ANG_PIT_P 3.5
ATC_ANGLE_MAX 30
WP_SPD 3
WP_SPD_UP 1.5
WP_SPD_DN 1
WP_ACC 1
PILOT_TKO_ALT_M 3
LAND_SPD_MS 0.4
RTL_ALT_M 10
FENCE_ENABLE 1
FENCE_TYPE 3
FENCE_ALT_MAX 30
FENCE_RADIUS 100
FENCE_ACTION 1
# No RC receiver on the deterministic SITL bench. MAVLink GCS loss lands.
FS_THR_ENABLE 0
FS_GCS_ENABLE 5
MAV_GCS_SYSID 255
