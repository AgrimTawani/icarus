+// Native tagged scalar values may use the model's Python spelling. These are
+// values only, never executable expressions; schema strings stay strings.
+static void test_tagged_native_scalars(testing & t) {
+    generation_params inputs;
+    json parameters = json::parse(R"({"type":"object","properties":{"enabled":{"type":"boolean"},"optional":{"type":"boolean"},"label":{"type":"string"},"nullable":{"type":["boolean","null"]}},"required":["enabled","label"],"additionalProperties":false})");
+    inputs.tools = json::array({json::object({{"type","function"},{"function",json::object({{"name","sample"},{"parameters",parameters}})}})});
+    inputs.tool_choice = COMMON_CHAT_TOOL_CHOICE_REQUIRED;
+    inputs.parallel_tool_calls = true;
+    inputs.messages = json::array({{{"role","user"},{"content","Call sample."}}});
+    inputs.reasoning_format = COMMON_REASONING_FORMAT_NONE;
+    analyze_tools tools;
+    tools.format.mode = tool_format::TAG_WITH_TAGGED;
+    tools.format.per_call_start = "<tool_call>";
+    tools.format.per_call_end = "</tool_call>";
+    tools.function.name_prefix = "<function=";
+    tools.function.name_suffix = ">";
+    tools.function.close = "</function>";
+    tools.arguments.name_prefix = "<parameter=";
+    tools.arguments.name_suffix = ">";
+    tools.arguments.value_prefix = "\n";
+    tools.arguments.value_suffix = "\n</parameter>\n";
+    auto automatic = build_chat_peg_parser([&](common_chat_peg_builder & p) {
+        parser_build_context ctx(p,inputs); return tools.build_parser(ctx);
+    });
+    common_chat_template tmpl(read_file("models/templates/Qwen3.5-4B.jinja"),"","");
+    auto data = common_chat_params_init_qwen3_coder(tmpl,inputs);
+    common_peg_arena specialized; specialized.load(data.parser);
+    auto call = [](const std::string & yes,const std::string & no,const std::string & null_value) {
+        return "<tool_call>\n<function=sample>\n<parameter=optional>\n" + no +
+            "\n</parameter>\n<parameter=label>\nTrue\n</parameter>\n<parameter=enabled>\n" + yes +
+            "\n</parameter>\n<parameter=nullable>\n" + null_value +
+            "\n</parameter>\n</function>\n</tool_call>";
+    };
+    for (bool native : {false,true}) {
+        for (bool python : {false,true}) {
+            const auto text=call(python ? "True":"true",python ? "False":"false",python ? "None":"null");
+            const std::string input = (native ? "<|im_start|>assistant\n":"") + text;
+            common_peg_parse_context ctx(input);
+            auto result=native ? specialized.parse(ctx):automatic.parse(ctx);
+            if (t.assert_true(std::string(native ? "specialized ":"automatic ") + (python ? "Python scalars parse":"JSON scalars parse"),result.success())) {
+                common_chat_msg msg; common_chat_peg_mapper(msg).from_ast(ctx.ast,result);
+                t.assert_equal("one scalar call",size_t(1),msg.tool_calls.size());
+                if (!msg.tool_calls.empty()) {
+                    auto args=json::parse(msg.tool_calls[0].arguments);
+                    t.assert_true("native booleans become JSON booleans",args["enabled"]==true && args["optional"]==false);
+                    t.assert_true("native null becomes JSON null",args["nullable"].is_null());
+                    t.assert_equal("string True is not coerced",std::string("True"),args["label"].get<std::string>());
+                }
+            }
+        }
+        const std::string invalid_text = (native ? "<|im_start|>assistant\n":"") + call("unknown_value","false","null");
+        common_peg_parse_context invalid(invalid_text);
+        t.assert_true("unknown scalar spellings rejected",!(native ? specialized.parse(invalid):automatic.parse(invalid)).success());
+    }
+}
