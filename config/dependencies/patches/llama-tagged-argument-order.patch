+// Tagged parameters are a JSON object, not an ordered positional argument list.
+static void test_tagged_args_arbitrary_order(testing & t) {
+    generation_params inputs;
+    json parameters = json::object();
+    parameters["type"] = "object";
+    parameters["properties"] = json::object();
+    for (const auto & key : {"first", "second", "optional"}) {
+        parameters["properties"][key] = json::object({{"type", "string"}});
+    }
+    parameters["required"] = json::array({"first", "second"});
+    json tool = json::object();
+    tool["type"] = "function";
+    tool["function"] = json::object({{"name", "sample"}, {"parameters", parameters}});
+    inputs.tools = json::array({tool});
+    inputs.tool_choice = COMMON_CHAT_TOOL_CHOICE_REQUIRED;
+    inputs.parallel_tool_calls = true;
+    analyze_tools tools;
+    tools.format.mode = tool_format::TAG_WITH_TAGGED;
+    tools.format.per_call_start = "<tool_call>";
+    tools.format.per_call_end = "</tool_call>";
+    tools.function.name_prefix = "<function=";
+    tools.function.name_suffix = ">";
+    tools.function.close = "</function>";
+    tools.arguments.name_prefix = "<parameter=";
+    tools.arguments.name_suffix = ">";
+    tools.arguments.value_suffix = "</parameter>";
+    auto parser = build_chat_peg_parser([&](common_chat_peg_builder & p) {
+        parser_build_context ctx(p, inputs);
+        return tools.build_parser(ctx);
+    });
+    auto call = [](const std::vector<std::string> & keys) {
+        std::string output = "<tool_call>\n<function=sample>\n";
+        for (const auto & key : keys) {
+            output += "<parameter=" + key + ">\n" + key + "-value\n</parameter>\n";
+        }
+        return output + "</function>\n</tool_call>";
+    };
+    std::vector<std::string> keys = {"first", "optional", "second"};
+    do {
+        common_peg_parse_context ctx(call(keys));
+        auto result = parser.parse(ctx);
+        if (t.assert_true("all argument permutations parse", result.success())) {
+            common_chat_msg msg;
+            common_chat_peg_mapper(msg).from_ast(ctx.ast, result);
+            t.assert_equal("one parsed call", size_t(1), msg.tool_calls.size());
+            if (!msg.tool_calls.empty()) {
+                auto args = json::parse(msg.tool_calls[0].arguments);
+                t.assert_true("both mandatory arguments retained", args.contains("first") && args.contains("second"));
+                t.assert_true("optional argument retained", args.contains("optional"));
+            }
+        }
+    } while (std::next_permutation(keys.begin(), keys.end()));
+    for (const auto & keys : std::vector<std::vector<std::string>>{
+            {"first", "second"}, {"second", "first"}}) {
+        common_peg_parse_context ctx(call(keys));
+        t.assert_true("optional argument may be omitted", parser.parse(ctx).success());
+    }
+    for (const auto & keys : std::vector<std::vector<std::string>>{
+            {"first"}, {"second"}, {"first", "unknown", "second"},
+            {"first", "second", "first"}}) {
+        common_peg_parse_context ctx(call(keys));
+        t.assert_true("missing, unknown or repeated required fields rejected", !parser.parse(ctx).success());
+    }
+    common_peg_parse_context ctx(call({"optional", "second", "first"}) + "\n" + call({"second", "first"}));
+    auto result = parser.parse(ctx);
+    if (t.assert_true("multiple complete proposals parse", result.success())) {
+        common_chat_msg msg;
+        common_chat_peg_mapper(msg).from_ast(ctx.ast, result);
+        t.assert_equal("both proposals retained", size_t(2), msg.tool_calls.size());
+    }
+    // Qwen3.5 uses the specialized tagged parser, not the auto-generator.
+    common_chat_template tmpl(read_file("models/templates/Qwen3.5-4B.jinja"), "", "");
+    inputs.messages = json::array({{{"role", "user"}, {"content", "Call the sample tool."}}});
+    inputs.reasoning_format = COMMON_REASONING_FORMAT_NONE;
+    auto data = common_chat_params_init_qwen3_coder(tmpl, inputs);
+    common_peg_arena specialized;
+    specialized.load(data.parser);
+    keys = {"first", "optional", "second"};
+    do {
+        common_peg_parse_context input("<|im_start|>assistant\n" + call(keys));
+        t.assert_true("Qwen3.5 accepts every named-argument order", specialized.parse(input).success());
+    } while (std::next_permutation(keys.begin(), keys.end()));
+    for (const auto & missing : std::vector<std::vector<std::string>>{{"first"}, {"second"}}) {
+        common_peg_parse_context input("<|im_start|>assistant\n" + call(missing));
+        t.assert_true("Qwen3.5 still rejects missing mandatory fields", !specialized.parse(input).success());
+    }
+
+}
