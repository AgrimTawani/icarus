{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icarus.dcm.context.v3",
  "type": "object",
  "required": [
    "contract_version", "context_version", "observed_at_unix_ms",
    "state", "perception", "state_summary", "perception_summary",
    "failure_signals", "source_evidence", "body", "soul", "world_facts", "macro_catalog",
    "mission_contract",
    "context_budget", "context_sha256"
  ],
  "properties": {
    "context_version": {"const": "dcm-context-v3-compact"},
    "contract_version": {"const": "dcm-contract-v3-compact"},
    "observed_at_unix_ms": {"type": ["integer", "string"]},
    "state": {"type": "object"},
    "perception": {"type": "object"},
    "state_summary": {"type": "object"},
    "perception_summary": {
      "type": "object",
      "properties": {
        "obstacle_sectors": {
          "type": "object",
          "propertyNames": {"enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]}
        }
      }
    },
    "failure_signals": {"type": "object"},
    "source_evidence": {
      "type": "object",
      "required": [
        "state_observed_at_unix_ms", "perception_observed_at_unix_ms",
        "perception_age_ms", "perception_health", "confidence_source"
      ],
      "properties": {
        "state_observed_at_unix_ms": {"type": ["integer", "string", "null"]},
        "perception_observed_at_unix_ms": {"type": ["integer", "string", "null"]},
        "perception_age_ms": {"type": ["integer", "number", "null"], "minimum": 0},
        "perception_health": {"type": ["string", "null"]},
        "confidence_source": {"const": "normalized_deterministic_contract"}
      },
      "additionalProperties": false
    },
    "mission_macro": {"type": ["object", "null"]},
    "mission_contract": {
      "type": "object",
      "required": ["schema", "mission_type", "objectives", "pending", "completed"],
      "properties": {
        "schema": {"const": "icarus.dcm.mission-contract.v1"},
        "mission_type": {"type": "string"},
        "objectives": {"type": "array"},
        "pending": {"type": "array", "items": {"type": "string"}},
        "completed": {"type": "array", "items": {"type": "string"}},
        "permitted_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "body": {"type": "object"},
    "soul": {"type": "object"},
    "world_facts": {"type": "object"},
    "macro_catalog": {"type": "array", "maxItems": 8},
    "context_budget": {
      "type": "object",
      "required": ["max_bytes", "payload_bytes", "estimated_tokens_upper_bound"],
      "properties": {
      "max_bytes": {"const": 8000},
      "payload_bytes": {"type": "integer", "maximum": 8000},
      "estimated_tokens_upper_bound": {"type": "integer", "maximum": 2667}
      }
    },
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
