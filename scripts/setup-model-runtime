#!/usr/bin/env bash
# Provision the local model runtime for Phase 11: build dependencies, CUDA
# toolkit, llama.cpp with GPU support, and the pinned Qwen GGUF artifacts.
#
# Safe to re-run. Every step detects existing work and skips it, so an
# interrupted run can simply be started again.
#
# Assumes sudo has already been authenticated in this terminal.
# Rationale for the selected artifacts: docs/architecture/DCM-MODEL-SELECTION.md

set -uo pipefail

MODELS_DIR="${MODELS_DIR:-$HOME/models}"
QWEN_DIR="${MODELS_DIR}/qwen"
VENV_DIR="${MODELS_DIR}/.venv"
LLAMA_DIR="${MODELS_DIR}/llama.cpp"
LOG_FILE="${MODELS_DIR}/setup-$(date +%Y%m%dT%H%M%S).log"
CUDA_ARCH="${CUDA_ARCH:-89}"   # RTX 4050 Laptop = Ada Lovelace = sm_89

HF_REPO="bartowski/Qwen_Qwen3-4B-Instruct-2507-GGUF"
PRIMARY="Qwen_Qwen3-4B-Instruct-2507-Q5_K_M.gguf"
SECONDARY="Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf"

TOTAL_STEPS=9
STEP=0
declare -a RESULTS=()
START_ALL=$(date +%s)

C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'

log()  { printf '%s\n' "$*" >>"${LOG_FILE}"; }
say()  { printf '%s\n' "$*"; log "$*"; }

begin_step() {
  STEP=$((STEP + 1))
  STEP_NAME="$1"
  STEP_START=$(date +%s)
  printf '\n%s[%d/%d]%s %s%s%s\n' \
    "${C_BLUE}" "${STEP}" "${TOTAL_STEPS}" "${C_RESET}" \
    "${C_BOLD}" "${STEP_NAME}" "${C_RESET}"
  log "=== [${STEP}/${TOTAL_STEPS}] ${STEP_NAME} ==="
}

ok()      { local d=$(( $(date +%s) - STEP_START ))
            printf '      %s[ok]%s %s %s(%ss)%s\n' "${C_GREEN}" "${C_RESET}" "$1" "${C_DIM}" "${d}" "${C_RESET}"
            RESULTS+=("ok|${STEP_NAME}|$1|${d}s"); log "[ok] $1 (${d}s)"; }
skipped() { local d=$(( $(date +%s) - STEP_START ))
            printf '      %s[skip]%s %s\n' "${C_YELLOW}" "${C_RESET}" "$1"
            RESULTS+=("skip|${STEP_NAME}|$1|${d}s"); log "[skip] $1"; }
fail()    { local d=$(( $(date +%s) - STEP_START ))
            printf '      %s[FAIL]%s %s\n' "${C_RED}" "${C_RESET}" "$1"
            RESULTS+=("FAIL|${STEP_NAME}|$1|${d}s"); log "[FAIL] $1"
            summary; exit 1; }
note()    { printf '      %s%s%s\n' "${C_DIM}" "$*" "${C_RESET}"; log "  $*"; }

summary() {
  local total=$(( $(date +%s) - START_ALL ))
  printf '\n%s=== Summary ===%s\n' "${C_BOLD}" "${C_RESET}"
  local row status name detail dur mark colour
  for row in "${RESULTS[@]}"; do
    IFS='|' read -r status name detail dur <<<"${row}"
    case "${status}" in
      ok)   mark='v'; colour="${C_GREEN}"  ;;
      skip) mark='-'; colour="${C_YELLOW}" ;;
      *)    mark='x'; colour="${C_RED}"    ;;
    esac
    printf '  %s%s%s  %-34s %s%s%s\n' \
      "${colour}" "${mark}" "${C_RESET}" "${name}" "${C_DIM}" "${detail}" "${C_RESET}"
  done
  printf '\n  Elapsed: %dm %ds\n  Log: %s\n' \
    $((total / 60)) $((total % 60)) "${LOG_FILE}"
}

mkdir -p "${MODELS_DIR}" "${QWEN_DIR}"
: >"${LOG_FILE}"

printf '%sIcarus Phase 11 model runtime setup%s\n' "${C_BOLD}" "${C_RESET}"
printf '%sTarget: %s | log: %s%s\n' "${C_DIM}" "${MODELS_DIR}" "${LOG_FILE}" "${C_RESET}"

# ---------------------------------------------------------------- 1. preflight
begin_step "Preflight checks"
command -v nvidia-smi >/dev/null || fail "nvidia-smi not found; NVIDIA driver required"
GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)
VRAM_FREE=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -1)
DISK_FREE_GB=$(df -BG --output=avail "${MODELS_DIR}" | tail -1 | tr -dc '0-9')
note "GPU: ${GPU_NAME}"
note "VRAM free: ${VRAM_FREE} MiB"
note "Disk free: ${DISK_FREE_GB} GiB"
(( DISK_FREE_GB >= 20 )) || fail "need >=20 GiB free, found ${DISK_FREE_GB} GiB"
(( VRAM_FREE >= 4200 )) || note "WARNING: <4.2 GiB VRAM free; close GPU apps before the smoke test"
ok "environment suitable"

# ------------------------------------------------------------ 2. build deps
begin_step "Build dependencies (apt)"
APT_PKGS=(build-essential cmake git ccache libcurl4-openssl-dev python3-venv)
MISSING=()
for p in "${APT_PKGS[@]}"; do
  dpkg -s "$p" >/dev/null 2>&1 || MISSING+=("$p")
done
if (( ${#MISSING[@]} == 0 )); then
  skipped "all present: ${APT_PKGS[*]}"
else
  note "installing: ${MISSING[*]}"
  sudo apt-get update -qq >>"${LOG_FILE}" 2>&1
  sudo apt-get install -y "${MISSING[@]}" >>"${LOG_FILE}" 2>&1 \
    || fail "apt install failed; see ${LOG_FILE}"
  ok "installed ${#MISSING[@]} package(s)"
fi

# ------------------------------------------------------------ 3. CUDA toolkit
begin_step "CUDA toolkit (large: ~3 GiB, several minutes)"
if command -v nvcc >/dev/null 2>&1; then
  skipped "nvcc present: $(nvcc --version | grep -o 'release [0-9.]*' | head -1)"
elif [[ -x /usr/local/cuda/bin/nvcc ]]; then
  export PATH="/usr/local/cuda/bin:${PATH}"
  skipped "nvcc found at /usr/local/cuda/bin"
else
  note "installing nvidia-cuda-toolkit, this is the slowest step..."
  sudo apt-get install -y nvidia-cuda-toolkit >>"${LOG_FILE}" 2>&1 \
    || fail "CUDA toolkit install failed; see ${LOG_FILE}"
  command -v nvcc >/dev/null || fail "nvcc still not on PATH after install"
  ok "nvcc $(nvcc --version | grep -o 'release [0-9.]*' | head -1)"
fi

# ------------------------------------------------- 4. python env for downloads
begin_step "Python environment for model downloads"
if [[ -x "${VENV_DIR}/bin/hf" ]]; then
  skipped "huggingface_hub already installed"
else
  note "creating venv at ${VENV_DIR} (kept separate from the project .venv)"
  python3 -m venv "${VENV_DIR}" >>"${LOG_FILE}" 2>&1 || fail "venv creation failed"
  "${VENV_DIR}/bin/pip" install -q --upgrade pip >>"${LOG_FILE}" 2>&1
  "${VENV_DIR}/bin/pip" install -q "huggingface_hub[hf_transfer,cli]" >>"${LOG_FILE}" 2>&1 \
    || fail "huggingface_hub install failed; see ${LOG_FILE}"
  [[ -x "${VENV_DIR}/bin/hf" ]] || fail "hf CLI missing after install"
  ok "huggingface_hub ready"
fi

# ------------------------------------------------------------ 5. llama.cpp src
begin_step "llama.cpp source"
if [[ -d "${LLAMA_DIR}/.git" ]]; then
  note "updating existing checkout"
  git -C "${LLAMA_DIR}" fetch --quiet origin >>"${LOG_FILE}" 2>&1
  git -C "${LLAMA_DIR}" pull --quiet --ff-only >>"${LOG_FILE}" 2>&1 || note "fast-forward skipped"
  skipped "already cloned at ${LLAMA_DIR}"
else
  git clone --depth 1 https://github.com/ggml-org/llama.cpp "${LLAMA_DIR}" >>"${LOG_FILE}" 2>&1 \
    || fail "clone failed; see ${LOG_FILE}"
  ok "cloned"
fi
LLAMA_REV=$(git -C "${LLAMA_DIR}" rev-parse --short HEAD)
note "revision ${LLAMA_REV}"

# --------------------------------------------------------- 6. build llama.cpp
begin_step "Build llama.cpp with CUDA (several minutes)"
if [[ -x "${LLAMA_DIR}/build/bin/llama-cli" ]]; then
  skipped "llama-cli already built"
else
  note "configuring for sm_${CUDA_ARCH}"
  cmake -S "${LLAMA_DIR}" -B "${LLAMA_DIR}/build" \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
    -DLLAMA_CURL=ON \
    -DCMAKE_BUILD_TYPE=Release >>"${LOG_FILE}" 2>&1 \
    || fail "cmake configure failed; see ${LOG_FILE}"
  note "compiling with $(nproc) jobs, progress in the log..."
  cmake --build "${LLAMA_DIR}/build" --config Release -j"$(nproc)" \
    --target llama-cli llama-server >>"${LOG_FILE}" 2>&1 \
    || fail "build failed; see ${LOG_FILE}"
  [[ -x "${LLAMA_DIR}/build/bin/llama-cli" ]] || fail "llama-cli missing after build"
  ok "built llama-cli and llama-server"
fi

# ------------------------------------------------------ 7. verify GPU support
begin_step "Verify CUDA backend is active"
DEVICES=$("${LLAMA_DIR}/build/bin/llama-cli" --list-devices 2>&1)
log "${DEVICES}"
if grep -qi cuda <<<"${DEVICES}"; then
  note "$(grep -i cuda <<<"${DEVICES}" | head -1)"
  ok "CUDA device visible to llama.cpp"
else
  fail "llama.cpp built without a usable CUDA device; inspect ${LOG_FILE}"
fi

# ------------------------------------------------------- 8. download artifacts
begin_step "Download Qwen artifacts (~5 GiB, slowest on a slow link)"
export HF_HUB_ENABLE_HF_TRANSFER=1
download_one() {
  local name="$1" label="$2"
  if [[ -f "${QWEN_DIR}/${name}" ]]; then
    note "${label}: already present ($(du -h "${QWEN_DIR}/${name}" | cut -f1))"
    return 0
  fi
  note "${label}: downloading ${name}"
  "${VENV_DIR}/bin/hf" download "${HF_REPO}" "${name}" \
    --local-dir "${QWEN_DIR}" 2>&1 | tee -a "${LOG_FILE}" | tail -1
  [[ -f "${QWEN_DIR}/${name}" ]] || return 1
  note "${label}: done ($(du -h "${QWEN_DIR}/${name}" | cut -f1))"
}
download_one "${PRIMARY}"   "primary   Q5_K_M" || fail "primary download failed"
download_one "${SECONDARY}" "secondary Q4_K_M" || fail "secondary download failed"
ok "both artifacts present"

# ---------------------------------------------------------- 9. pin provenance
begin_step "Checksum and pin provenance"
MANIFEST="${QWEN_DIR}/MANIFEST.json"
note "hashing (a few seconds per GiB)..."
SHA_PRIMARY=$(sha256sum "${QWEN_DIR}/${PRIMARY}" | cut -d' ' -f1)
SHA_SECONDARY=$(sha256sum "${QWEN_DIR}/${SECONDARY}" | cut -d' ' -f1)
cat >"${MANIFEST}" <<JSON
{
  "recorded_at": "$(date -Is)",
  "repository": "${HF_REPO}",
  "llama_cpp_revision": "${LLAMA_REV}",
  "cuda_arch": "sm_${CUDA_ARCH}",
  "artifacts": [
    {
      "role": "primary",
      "path": "${QWEN_DIR}/${PRIMARY}",
      "quantization": "q5_k_m",
      "sha256": "${SHA_PRIMARY}"
    },
    {
      "role": "secondary",
      "path": "${QWEN_DIR}/${SECONDARY}",
      "quantization": "q4_k_m",
      "sha256": "${SHA_SECONDARY}"
    }
  ]
}
JSON
note "Q5_K_M  ${SHA_PRIMARY}"
note "Q4_K_M  ${SHA_SECONDARY}"
ok "manifest written to ${MANIFEST}"

summary

cat <<EOF

${C_BOLD}Next${C_RESET}
  Smoke test the primary artifact:

    ${LLAMA_DIR}/build/bin/llama-cli \\
      -m ${QWEN_DIR}/${PRIMARY} \\
      -ngl 99 -c 8192 --temp 0 \\
      -p 'Reply with only this JSON object: {"action":"none","arguments":{}}'

  -ngl 99 offloads every layer to the GPU. If it reports an out-of-memory
  error, close GPU applications or add --cache-type-k q8_0 --cache-type-v q8_0
  before reducing the quantization.

  Then hand ${MANIFEST} to the Phase 11 adapter work.
EOF
