#!/usr/bin/env bash
# Provision the local model runtime for Phase 11.
#
# Layout, deliberately:
#   third_party/llama.cpp  external source tree, pinned by third_party.lock.json
#   ~/models/qwen/         GGUF weights only; large binaries kept out of the repo
#   logs/model-runtime/    setup logs, already gitignored
#
# Safe to re-run. Every step detects existing work and skips it, so an
# interrupted run can simply be started again.
#
# Assumes sudo has already been authenticated in this terminal.
# Rationale for the selected artifacts: docs/architecture/DCM-MODEL-SELECTION.md

set -uo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
LOCK_FILE="${PROJECT_ROOT}/config/dependencies/third_party.lock.json"
LLAMA_DIR="${PROJECT_ROOT}/third_party/llama.cpp"
VENV="${PROJECT_ROOT}/.venv"
LOG_DIR="${PROJECT_ROOT}/logs/model-runtime"
LOG_FILE="${LOG_DIR}/setup-$(date +%Y%m%dT%H%M%S).log"

WEIGHTS_DIR="${WEIGHTS_DIR:-$HOME/models/qwen}"
CUDA_ARCH="${CUDA_ARCH:-89}"   # RTX 4050 Laptop = Ada Lovelace = sm_89

HF_REPO="bartowski/Qwen_Qwen3-4B-Instruct-2507-GGUF"
PRIMARY="Qwen_Qwen3-4B-Instruct-2507-Q5_K_M.gguf"
SECONDARY="Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf"

TOTAL_STEPS=8
STEP=0
declare -a RESULTS=()
START_ALL=$(date +%s)

C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'

log() { printf '%s\n' "$*" >>"${LOG_FILE}"; }

begin_step() {
  STEP=$((STEP + 1))
  STEP_NAME="$1"
  STEP_START=$(date +%s)
  printf '\n%s[%d/%d]%s %s%s%s\n' \
    "${C_BLUE}" "${STEP}" "${TOTAL_STEPS}" "${C_RESET}" \
    "${C_BOLD}" "${STEP_NAME}" "${C_RESET}"
  log "=== [${STEP}/${TOTAL_STEPS}] ${STEP_NAME} ==="
}

ok()      { local d=$(( $(date +%s) - STEP_START ))
            printf '      %s[ok]%s %s %s(%ss)%s\n' "${C_GREEN}" "${C_RESET}" "$1" "${C_DIM}" "${d}" "${C_RESET}"
            RESULTS+=("ok|${STEP_NAME}|$1"); log "[ok] $1 (${d}s)"; }
skipped() { printf '      %s[skip]%s %s\n' "${C_YELLOW}" "${C_RESET}" "$1"
            RESULTS+=("skip|${STEP_NAME}|$1"); log "[skip] $1"; }
fail()    { printf '      %s[FAIL]%s %s\n' "${C_RED}" "${C_RESET}" "$1"
            RESULTS+=("FAIL|${STEP_NAME}|$1"); log "[FAIL] $1"
            summary; exit 1; }
note()    { printf '      %s%s%s\n' "${C_DIM}" "$*" "${C_RESET}"; log "  $*"; }

summary() {
  local total=$(( $(date +%s) - START_ALL ))
  printf '\n%s=== Summary ===%s\n' "${C_BOLD}" "${C_RESET}"
  local row status name detail mark colour
  for row in "${RESULTS[@]}"; do
    IFS='|' read -r status name detail <<<"${row}"
    case "${status}" in
      ok)   mark='v'; colour="${C_GREEN}"  ;;
      skip) mark='-'; colour="${C_YELLOW}" ;;
      *)    mark='x'; colour="${C_RED}"    ;;
    esac
    printf '  %s%s%s  %-32s %s%s%s\n' \
      "${colour}" "${mark}" "${C_RESET}" "${name}" "${C_DIM}" "${detail}" "${C_RESET}"
  done
  printf '\n  Elapsed: %dm %ds\n  Log: %s\n' \
    $((total / 60)) $((total % 60)) "${LOG_FILE}"
}

mkdir -p "${LOG_DIR}" "${WEIGHTS_DIR}"
: >"${LOG_FILE}"

printf '%sIcarus Phase 11 model runtime setup%s\n' "${C_BOLD}" "${C_RESET}"
printf '%sruntime: %s%s\n' "${C_DIM}" "${LLAMA_DIR}" "${C_RESET}"
printf '%sweights: %s%s\n' "${C_DIM}" "${WEIGHTS_DIR}" "${C_RESET}"

# ---------------------------------------------------------------- 1. preflight
begin_step "Preflight checks"
command -v nvidia-smi >/dev/null || fail "nvidia-smi not found; NVIDIA driver required"
[[ -f "${LOCK_FILE}" ]] || fail "missing ${LOCK_FILE}"
[[ -x "${VENV}/bin/hf" ]] || fail "hf CLI missing; run ./scripts/bootstrap --profile ml"
GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)
VRAM_FREE=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -1)
DISK_FREE_GB=$(df -BG --output=avail "${WEIGHTS_DIR}" | tail -1 | tr -dc '0-9')
note "GPU: ${GPU_NAME}"
note "VRAM free: ${VRAM_FREE} MiB"
note "Disk free: ${DISK_FREE_GB} GiB"
(( DISK_FREE_GB >= 20 )) || fail "need >=20 GiB free, found ${DISK_FREE_GB} GiB"
(( VRAM_FREE >= 4200 )) || note "WARNING: <4.2 GiB VRAM free; close GPU apps before the smoke test"
ok "environment suitable"

# ------------------------------------------------------------ 2. build deps
begin_step "Build dependencies (apt)"
APT_PKGS=(build-essential cmake git ccache libcurl4-openssl-dev)
MISSING=()
for p in "${APT_PKGS[@]}"; do
  dpkg -s "$p" >/dev/null 2>&1 || MISSING+=("$p")
done
if (( ${#MISSING[@]} == 0 )); then
  skipped "all present"
else
  note "installing: ${MISSING[*]}"
  sudo apt-get update -qq >>"${LOG_FILE}" 2>&1
  sudo apt-get install -y "${MISSING[@]}" >>"${LOG_FILE}" 2>&1 \
    || fail "apt install failed; see ${LOG_FILE}"
  ok "installed ${#MISSING[@]} package(s)"
fi

# ------------------------------------------------------------ 3. CUDA toolkit
begin_step "CUDA toolkit (~3 GiB, several minutes)"
if command -v nvcc >/dev/null 2>&1; then
  skipped "nvcc present: $(nvcc --version | grep -o 'release [0-9.]*' | head -1)"
elif [[ -x /usr/local/cuda/bin/nvcc ]]; then
  export PATH="/usr/local/cuda/bin:${PATH}"
  skipped "nvcc found at /usr/local/cuda/bin"
else
  # --no-install-recommends avoids the nsight GUI profilers and their OpenJDK 8
  # dependency: 48 packages instead of 68, and no Java on the host. A dry run
  # confirmed this removes and upgrades nothing, so it cannot disturb other
  # projects, and `apt-get remove nvidia-cuda-toolkit` fully reverses it.
  note "installing nvidia-cuda-toolkit (lean), this is the slowest step..."
  sudo apt-get install -y --no-install-recommends nvidia-cuda-toolkit \
    >>"${LOG_FILE}" 2>&1 || fail "CUDA toolkit install failed; see ${LOG_FILE}"
  command -v nvcc >/dev/null || fail "nvcc still not on PATH after install"
  ok "nvcc $(nvcc --version | grep -o 'release [0-9.]*' | head -1)"
fi

# ------------------------------------------------- 4. pinned llama.cpp source
begin_step "llama.cpp source (pinned revision)"
lock_value() {
  "${VENV}/bin/python" - "${LOCK_FILE}" "$1" "$2" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))["repositories"][sys.argv[2]][sys.argv[3]])
PY
}
LLAMA_URL="$(lock_value llama_cpp url)"   || fail "llama_cpp missing from lock file"
LLAMA_REV="$(lock_value llama_cpp revision)" || fail "llama_cpp revision missing"
note "pinned to ${LLAMA_REV:0:12} from third_party.lock.json"
if [[ -d "${LLAMA_DIR}/.git" ]]; then
  # Match bootstrap's contract: refuse to clobber a dirty external checkout.
  git -C "${LLAMA_DIR}" diff --quiet && git -C "${LLAMA_DIR}" diff --cached --quiet \
    || fail "third_party/llama.cpp has local changes; resolve them first"
  [[ "$(git -C "${LLAMA_DIR}" remote get-url origin)" == "${LLAMA_URL}" ]] \
    || fail "unexpected origin in third_party/llama.cpp"
else
  mkdir -p "$(dirname "${LLAMA_DIR}")"
  git init --quiet "${LLAMA_DIR}" >>"${LOG_FILE}" 2>&1
  git -C "${LLAMA_DIR}" remote add origin "${LLAMA_URL}"
fi
if [[ "$(git -C "${LLAMA_DIR}" rev-parse HEAD 2>/dev/null)" == "${LLAMA_REV}" ]]; then
  skipped "already at pinned revision"
else
  note "fetching pinned revision..."
  git -C "${LLAMA_DIR}" fetch --depth 1 origin "${LLAMA_REV}" >>"${LOG_FILE}" 2>&1 \
    || fail "fetch failed; see ${LOG_FILE}"
  git -C "${LLAMA_DIR}" checkout --detach "${LLAMA_REV}" >>"${LOG_FILE}" 2>&1 \
    || fail "checkout failed; see ${LOG_FILE}"
  ok "checked out ${LLAMA_REV:0:12}"
fi

# --------------------------------------------------------- 5. build llama.cpp
begin_step "Build llama.cpp with CUDA (several minutes)"
BUILT_REV_FILE="${LLAMA_DIR}/build/.icarus-built-revision"
if [[ -x "${LLAMA_DIR}/build/bin/llama-cli" ]] \
   && [[ "$(cat "${BUILT_REV_FILE}" 2>/dev/null)" == "${LLAMA_REV}" ]]; then
  skipped "already built at pinned revision"
else
  note "configuring for sm_${CUDA_ARCH}"
  cmake -S "${LLAMA_DIR}" -B "${LLAMA_DIR}/build" \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
    -DLLAMA_CURL=ON \
    -DCMAKE_BUILD_TYPE=Release >>"${LOG_FILE}" 2>&1 \
    || fail "cmake configure failed; see ${LOG_FILE}"
  note "compiling with $(nproc) jobs, progress in the log..."
  cmake --build "${LLAMA_DIR}/build" --config Release -j"$(nproc)" \
    --target llama-cli llama-server >>"${LOG_FILE}" 2>&1 \
    || fail "build failed; see ${LOG_FILE}"
  [[ -x "${LLAMA_DIR}/build/bin/llama-cli" ]] || fail "llama-cli missing after build"
  printf '%s\n' "${LLAMA_REV}" >"${BUILT_REV_FILE}"
  ok "built llama-cli and llama-server"
fi

# ------------------------------------------------------ 6. verify GPU support
begin_step "Verify CUDA backend is active"
DEVICES=$("${LLAMA_DIR}/build/bin/llama-cli" --list-devices 2>&1)
log "${DEVICES}"
if grep -qi cuda <<<"${DEVICES}"; then
  note "$(grep -i cuda <<<"${DEVICES}" | head -1)"
  ok "CUDA device visible to llama.cpp"
else
  fail "llama.cpp built without a usable CUDA device; inspect ${LOG_FILE}"
fi

# ------------------------------------------------------- 7. download weights
begin_step "Download Qwen weights (~5 GiB)"
download_one() {
  local name="$1" label="$2"
  if [[ -f "${WEIGHTS_DIR}/${name}" ]]; then
    note "${label}: present ($(du -h "${WEIGHTS_DIR}/${name}" | cut -f1))"
    return 0
  fi
  note "${label}: downloading..."
  "${VENV}/bin/hf" download "${HF_REPO}" "${name}" \
    --local-dir "${WEIGHTS_DIR}" >>"${LOG_FILE}" 2>&1
  [[ -f "${WEIGHTS_DIR}/${name}" ]] || return 1
  note "${label}: done ($(du -h "${WEIGHTS_DIR}/${name}" | cut -f1))"
}
download_one "${PRIMARY}"   "primary   Q5_K_M" || fail "primary download failed"
download_one "${SECONDARY}" "secondary Q4_K_M" || fail "secondary download failed"
ok "both artifacts present"

# ---------------------------------------------------------- 8. pin provenance
begin_step "Checksum and pin provenance"
MANIFEST="${WEIGHTS_DIR}/MANIFEST.json"
note "hashing, a few seconds per GiB..."
SHA_PRIMARY=$(sha256sum "${WEIGHTS_DIR}/${PRIMARY}" | cut -d' ' -f1)
SHA_SECONDARY=$(sha256sum "${WEIGHTS_DIR}/${SECONDARY}" | cut -d' ' -f1)
cat >"${MANIFEST}" <<JSON
{
  "recorded_at": "$(date -Is)",
  "repository": "${HF_REPO}",
  "llama_cpp_revision": "${LLAMA_REV}",
  "llama_cpp_binary": "${LLAMA_DIR}/build/bin/llama-cli",
  "cuda_arch": "sm_${CUDA_ARCH}",
  "artifacts": [
    {
      "role": "primary",
      "path": "${WEIGHTS_DIR}/${PRIMARY}",
      "quantization": "q5_k_m",
      "sha256": "${SHA_PRIMARY}"
    },
    {
      "role": "secondary",
      "path": "${WEIGHTS_DIR}/${SECONDARY}",
      "quantization": "q4_k_m",
      "sha256": "${SHA_SECONDARY}"
    }
  ]
}
JSON
note "Q5_K_M  ${SHA_PRIMARY:0:32}..."
note "Q4_K_M  ${SHA_SECONDARY:0:32}..."
ok "manifest written"

summary

cat <<EOF

${C_BOLD}Next${C_RESET}
  Smoke test the primary artifact:

    ${LLAMA_DIR}/build/bin/llama-cli \\
      -m ${WEIGHTS_DIR}/${PRIMARY} \\
      -ngl 99 -c 8192 --temp 0 -no-cnv \\
      -p 'Reply with only this JSON object: {"action":"none","arguments":{}}'

  -ngl 99 offloads every layer to the GPU. On an out-of-memory error, close GPU
  applications or add --cache-type-k q8_0 --cache-type-v q8_0 before reducing
  the quantization.

  Then hand ${MANIFEST} to the Phase 11 adapter work.
EOF
