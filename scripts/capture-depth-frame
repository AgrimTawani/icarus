#!/usr/bin/env python3
"""Capture one Gazebo depth frame as a float32 ``.npy`` array.

This transport adapter intentionally carries no interpretation.  The caller
must supply calibrated mounting orientation to ``assess-landing-zone``; the
current Icarus RGB-D sensor is forward-facing and therefore must not be used to
approve a touchdown surface.
"""

import argparse
import json
import os
import threading
import time
from pathlib import Path

import numpy as np


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--topic", default="/icarus/sensors/rgbd/depth_image")
    parser.add_argument("--timeout", type=float, default=10.0)
    args = parser.parse_args()
    if args.timeout <= 0:
        parser.error("--timeout must be positive")
    if args.output.suffix != ".npy":
        parser.error("--output must end in .npy")

    from gz.msgs10.image_pb2 import Image
    from gz.transport13 import Node

    root = Path(__file__).resolve().parent.parent
    session_path = root / "logs/simulation/active_session.json"
    if not session_path.is_file():
        raise SystemExit("No active simulator; run ./scripts/start-sim first")
    session = json.loads(session_path.read_text())
    try:
        os.kill(int(session["launcher_pid"]), 0)
        os.environ["GZ_PARTITION"] = session["partition"]
    except (KeyError, ValueError, ProcessLookupError):
        raise SystemExit("Active simulator session is stale")

    received = threading.Event()
    result = {}

    def callback(message):
        if received.is_set():
            return
        width, height, step = int(message.width), int(message.height), int(message.step)
        payload = bytes(message.data)
        if width <= 0 or height <= 0 or step != width * 4 or len(payload) != height * step:
            result["error"] = "depth frame is not packed float32 metres"
        else:
            result["depth"] = np.frombuffer(payload, dtype=np.float32).reshape(height, width).copy()
        received.set()

    node = Node()
    if not node.subscribe(Image, args.topic, callback):
        raise RuntimeError("Could not subscribe to depth topic: " + args.topic)
    if not received.wait(args.timeout):
        raise TimeoutError("Timed out waiting for a depth frame")
    if "error" in result:
        raise RuntimeError(result["error"])
    args.output.parent.mkdir(parents=True, exist_ok=True)
    np.save(args.output, result["depth"], allow_pickle=False)
    metadata = {
        "schema": "icarus.camera.depth_frame.v1",
        "captured_at_unix_ms": int(time.time() * 1000),
        "width": int(result["depth"].shape[1]), "height": int(result["depth"].shape[0]),
        "encoding": "float32_metres", "source": "gazebo:" + args.topic,
        "depth": str(args.output.resolve()),
    }
    args.output.with_suffix(args.output.suffix + ".json").write_text(
        json.dumps(metadata, indent=2) + "\n")
    print(json.dumps(metadata, sort_keys=True))


if __name__ == "__main__":
    main()
