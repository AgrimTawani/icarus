#!/usr/bin/python3
"""Connect the keyboard/Xbox pilot client to the active Icarus simulator."""

import os
from pathlib import Path

root = Path(__file__).resolve().parent.parent
python = root / "third_party/ardupilot/.venv/bin/python"
client = root / "scripts/simulation/manual_control.py"
if not python.is_file():
    raise SystemExit("Missing ArduPilot Python environment; run the dependency setup first")
os.execv(str(python), [str(python), str(client), *os.sys.argv[1:]])
