#!/usr/bin/env bash
# Download the open-vocabulary detector and the second model family, and pin
# both by checksum.
#
# Two artifacts, for two different reasons:
#
#   detector  an open-vocabulary detector takes class names as text at
#             inference time, so defense, enterprise or any other vocabulary
#             is a different class list rather than a different model. It
#             produces boxes, which become counts, tracks and 3D positions.
#
#   llama     the Phase 11 exit gate requires that "Qwen and Llama candidates
#             can be evaluated without changing simulator or autonomy-core
#             code". It is small on purpose: it has to prove the adapter is
#             provider-neutral, not win a comparison.
#
# No new Python environment is created. torch 2.14+cu130 and transformers are
# already in the project venv, and gz frame capture runs as a separate system
# python3 process, so nothing is duplicated.
#
# Usage: ./scripts/setup-vision-runtime [--detector tiny|base|owlv2] [--skip-llama]

set -uo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${PROJECT_ROOT}/.venv"
LOG_DIR="${PROJECT_ROOT}/logs/model-runtime"
LOG_FILE="${LOG_DIR}/vision-setup-$(date +%Y%m%dT%H%M%S).log"

VISION_DIR="${VISION_DIR:-$HOME/models/vision}"
LLAMA_DIR="${LLAMA_DIR:-$HOME/models/llama}"
source "${PROJECT_ROOT}/scripts/lib/model_artifacts.sh"

DETECTOR_CHOICE="tiny"
SKIP_LLAMA=0
while (($#)); do
  case "$1" in
    --detector) DETECTOR_CHOICE="${2:?missing choice}"; shift 2 ;;
    --skip-llama) SKIP_LLAMA=1; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

case "${DETECTOR_CHOICE}" in
  tiny)  DETECTOR_REPO="IDEA-Research/grounding-dino-tiny" ;;
  base)  DETECTOR_REPO="IDEA-Research/grounding-dino-base" ;;
  owlv2) DETECTOR_REPO="google/owlv2-base-patch16-ensemble" ;;
  *) echo "--detector must be tiny, base or owlv2" >&2; exit 2 ;;
esac

LLAMA_REPO="bartowski/Llama-3.2-3B-Instruct-GGUF"
LLAMA_FILE="Llama-3.2-3B-Instruct-Q4_K_M.gguf"

TOTAL_STEPS=4
STEP=0
declare -a RESULTS=()
START_ALL=$(date +%s)

C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'

log()  { printf '%s\n' "$*" >>"${LOG_FILE}"; }
note() { printf '      %s%s%s\n' "${C_DIM}" "$*" "${C_RESET}"; log "  $*"; }

begin_step() {
  STEP=$((STEP + 1)); STEP_NAME="$1"; STEP_START=$(date +%s)
  printf '\n%s[%d/%d]%s %s%s%s\n' "${C_BLUE}" "${STEP}" "${TOTAL_STEPS}" \
    "${C_RESET}" "${C_BOLD}" "${STEP_NAME}" "${C_RESET}"
  log "=== [${STEP}/${TOTAL_STEPS}] ${STEP_NAME} ==="
}
ok()      { local d=$(( $(date +%s) - STEP_START ))
            printf '      %s[ok]%s %s %s(%ss)%s\n' "${C_GREEN}" "${C_RESET}" "$1" "${C_DIM}" "${d}" "${C_RESET}"
            RESULTS+=("ok|${STEP_NAME}|$1"); log "[ok] $1"; }
skipped() { printf '      %s[skip]%s %s\n' "${C_YELLOW}" "${C_RESET}" "$1"
            RESULTS+=("skip|${STEP_NAME}|$1"); log "[skip] $1"; }
fail()    { printf '      %s[FAIL]%s %s\n' "${C_RED}" "${C_RESET}" "$1"
            RESULTS+=("FAIL|${STEP_NAME}|$1"); log "[FAIL] $1"; summary; exit 1; }

summary() {
  local total=$(( $(date +%s) - START_ALL )) row status name detail mark colour
  printf '\n%s=== Summary ===%s\n' "${C_BOLD}" "${C_RESET}"
  for row in "${RESULTS[@]}"; do
    IFS='|' read -r status name detail <<<"${row}"
    case "${status}" in
      ok)   mark='v'; colour="${C_GREEN}"  ;;
      skip) mark='-'; colour="${C_YELLOW}" ;;
      *)    mark='x'; colour="${C_RED}"    ;;
    esac
    printf '  %s%s%s  %-34s %s%s%s\n' "${colour}" "${mark}" "${C_RESET}" \
      "${name}" "${C_DIM}" "${detail}" "${C_RESET}"
  done
  printf '\n  Elapsed: %dm %ds\n  Log: %s\n' \
    $((total / 60)) $((total % 60)) "${LOG_FILE}"
}

mkdir -p "${LOG_DIR}" "${VISION_DIR}" "${LLAMA_DIR}"
: >"${LOG_FILE}"
printf '%sIcarus vision and second-family model setup%s\n' "${C_BOLD}" "${C_RESET}"
printf '%sdetector: %s%s\n' "${C_DIM}" "${DETECTOR_REPO}" "${C_RESET}"

# ---------------------------------------------------------------- 1. preflight
begin_step "Preflight checks"
[[ -x "${VENV}/bin/hf" ]] || fail "hf CLI missing; run ./scripts/bootstrap --profile ml"
"${VENV}/bin/python" -c "import torch, transformers" 2>>"${LOG_FILE}" \
  || fail "torch and transformers are required in the project venv"
TORCH=$("${VENV}/bin/python" -c "import torch; print(torch.__version__, torch.cuda.is_available())")
note "torch ${TORCH}"
# gz bindings live in system python3; the project venv excludes system
# packages on purpose, so frame capture runs as its own process.
/usr/bin/python3 -c "from gz.transport13 import Node" 2>>"${LOG_FILE}" \
  || note "WARNING: gz.transport13 missing from system python3; frame capture will not run"
DISK=$(df -BG --output=avail "${VISION_DIR}" | tail -1 | tr -dc '0-9')
note "disk free: ${DISK} GiB"
(( DISK >= 15 )) || fail "need >=15 GiB free, found ${DISK} GiB"
ok "environment suitable"

# ------------------------------------------------------------- 2. detector
begin_step "Open-vocabulary detector (~1.2-1.8 GiB)"
DETECTOR_PATH="${VISION_DIR}/$(basename "${DETECTOR_REPO}")"
if [[ -f "${DETECTOR_PATH}/config.json" ]]; then
  skipped "already present at ${DETECTOR_PATH}"
else
  note "downloading ${DETECTOR_REPO}..."
  "${VENV}/bin/hf" download "${DETECTOR_REPO}" --local-dir "${DETECTOR_PATH}" \
    >>"${LOG_FILE}" 2>&1 || fail "detector download failed; see ${LOG_FILE}"
  [[ -f "${DETECTOR_PATH}/config.json" ]] || fail "detector config.json missing"
  ok "downloaded ($(du -sh "${DETECTOR_PATH}" | cut -f1))"
fi

# ---------------------------------------------------------------- 3. llama
begin_step "Second model family (Llama-3.2-3B, ~1.9 GiB)"
if (( SKIP_LLAMA )); then
  skipped "--skip-llama requested"
elif [[ -f "${LLAMA_DIR}/${LLAMA_FILE}" ]]; then
  skipped "already present ($(du -h "${LLAMA_DIR}/${LLAMA_FILE}" | cut -f1))"
else
  note "downloading ${LLAMA_FILE}..."
  "${VENV}/bin/hf" download "${LLAMA_REPO}" "${LLAMA_FILE}" \
    --local-dir "${LLAMA_DIR}" >>"${LOG_FILE}" 2>&1 \
    || fail "llama download failed; see ${LOG_FILE}"
  [[ -f "${LLAMA_DIR}/${LLAMA_FILE}" ]] || fail "llama artifact missing"
  ok "downloaded ($(du -h "${LLAMA_DIR}/${LLAMA_FILE}" | cut -f1))"
fi

# ------------------------------------------------------------ 4. provenance
begin_step "Checksum and pin provenance"
note "hashing..."
DETECTOR_SHA=$(find "${DETECTOR_PATH}" -type f \( -name '*.safetensors' -o -name '*.bin' \) \
  -print0 2>/dev/null | sort -z | xargs -0 sha256sum 2>/dev/null \
  | sha256sum | cut -d' ' -f1)
LLAMA_SHA=""
if [[ -f "${LLAMA_DIR}/${LLAMA_FILE}" ]]; then
  LLAMA_SHA=$(icarus_sha256 "${LLAMA_DIR}/${LLAMA_FILE}")
fi
MANIFEST="${VISION_DIR}/MANIFEST.json"
LOCK_FILE_PATH="${PROJECT_ROOT}/config/dependencies/third_party.lock.json"
LLAMA_CPP_REV=$("${VENV}/bin/python" -c '
import json, sys
print(json.load(open(sys.argv[1]))["repositories"]["llama_cpp"]["revision"])
' "${LOCK_FILE_PATH}")
# "artifacts" matches the schema RuntimeDescriptor.from_manifest already
# parses (setup-model-runtime's MANIFEST.json), so the second model family
# loads through the same code path as the primary Qwen artifact rather than
# needing a parallel loader for one field-name difference.
cat >"${MANIFEST}" <<JSON
{
  "recorded_at": "$(date -Is)",
  "detector": {
    "repository": "${DETECTOR_REPO}",
    "path": "${DETECTOR_PATH}",
    "weights_sha256": "${DETECTOR_SHA}",
    "runtime": "transformers",
    "open_vocabulary": true
  },
  "second_family": {
    "repository": "${LLAMA_REPO}",
    "path": "${LLAMA_DIR}/${LLAMA_FILE}",
    "quantization": "q4_k_m",
    "sha256": "${LLAMA_SHA}",
    "runtime": "llama_cpp"
  },
  "llama_cpp_revision": "${LLAMA_CPP_REV}",
  "artifacts": []
}
JSON
icarus_manifest_upsert "${MANIFEST}" \
  "{\"role\":\"second_family\",\"family\":\"llama\",\"path\":\"${LLAMA_DIR}/${LLAMA_FILE}\",\"quantization\":\"q4_k_m\",\"sha256\":\"${LLAMA_SHA}\"}"
note "detector ${DETECTOR_SHA:0:32}..."
[[ -n "${LLAMA_SHA}" ]] && note "llama    ${LLAMA_SHA:0:32}..."
ok "manifest written"

summary
cat <<EOF

${C_BOLD}Next${C_RESET}
  Detector and second family are pinned in:
    ${MANIFEST}

  The Llama artifact proves the adapter is provider-neutral:
    ./scripts/evaluate-dcm --runtime llama --manifest ${MANIFEST} --repeats 3
EOF
