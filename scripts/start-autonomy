#!/usr/bin/python3
"""Build and run the local Drone API against the active simulator."""

import json
import os
import signal
import socket
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
if sys.argv[1:] not in ([], ["--profile", "edge-vision"]):
    raise SystemExit("usage: ./scripts/start-autonomy [--profile edge-vision]")
edge_profile = sys.argv[1:] == ["--profile", "edge-vision"]
session_path = root / "logs/simulation/active_session.json"
if not session_path.is_file():
    raise SystemExit("No active simulator; run ./scripts/start-sim first")
session = json.loads(session_path.read_text())
if session.get("status") != "ready":
    raise SystemExit("Active simulator is not ready")
try:
    os.kill(int(session["launcher_pid"]), 0)
except (KeyError, ValueError, ProcessLookupError) as error:
    raise SystemExit("Simulator session is stale; restart ./scripts/start-sim") from error
with socket.socket() as probe:
    if probe.connect_ex(("127.0.0.1", 50051)) == 0:
        raise SystemExit("Drone API port 50051 is already in use")

subprocess.run([str(root / "scripts/generate-proto")], check=True)
subprocess.run(
    [
        "cmake", "-S", str(root), "-B", str(root / "build/phase8"),
        "-G", "Ninja", "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
    ],
    check=True,
)
subprocess.run(
    ["cmake", "--build", str(root / "build/phase8"), "-j", "2"], check=True
)
binary = root / "build/phase8/icarus-drone-api"
if not binary.is_file():
    raise SystemExit("Drone API target unavailable; simulation dependencies are incomplete")
os.chdir(root)
partition = session.get("partition")
if not partition:
    raise SystemExit("Active simulator did not publish its Gazebo partition")
os.environ["GZ_PARTITION"] = partition
gz_ip = session.get("gz_ip", "127.0.0.1")
if gz_ip != "127.0.0.1":
    raise SystemExit("Simulator session is not bound to the required loopback Gazebo transport")
os.environ["GZ_IP"] = gz_ip
scenario_name = session.get("scenario")
if not isinstance(scenario_name, str):
    raise SystemExit("Active simulator did not publish its scenario")
scenario_path = root / "simulation/scenarios" / (scenario_name + ".json")
scenario = json.loads(scenario_path.read_text())
if edge_profile and scenario_name != "edge_people_building":
    raise SystemExit("edge-vision requires ./scripts/start-sim --profile edge-vision")
if edge_profile:
    print("Edge camera tools are owned by the direct agent; no duplicate background detector is started.",
          flush=True)
faults = scenario.get("mavlink_fault_schedule", [])
if len(faults) > 1:
    raise SystemExit("Only one simulator MAVLink fault event is supported")
arguments = [
    str(binary), "--listen", "127.0.0.1:50051", "--mavlink-host",
    "127.0.0.1", "--mavlink-port", "5760", "--safety-policy",
    str(root / "config/safety/v1.yaml"),
]
# Battery percentage comes from live ArduPilot telemetry; never freeze initial SOC.
if faults:
    fault = faults[0]
    arguments.extend([
        "--test-mavlink-fault-mode", fault["mode"],
        "--test-mavlink-fault-after-ms", str(round(float(fault["start_s"]) * 1000)),
        "--test-mavlink-fault-duration-ms", str(round(float(fault["duration_s"]) * 1000)),
    ])
    if fault["mode"] == "delay":
        arguments.extend(["--test-mavlink-fault-latency-ms", str(round(float(fault["latency_ms"])))])
# Own the server and the simulator-session dependency. Ending or replacing
# the simulator must not leave an old API process holding the control port.
server = subprocess.Popen(arguments, cwd=root, env=os.environ.copy(),
                          start_new_session=True)
try:
    while True:
        try:
            exit_code = server.wait(timeout=1)
            break
        except subprocess.TimeoutExpired:
            try:
                active = json.loads(session_path.read_text())
                if (active.get('launcher_pid') != session['launcher_pid'] or
                        active.get('partition') != partition or active.get('status') != 'ready'):
                    raise RuntimeError('Simulator session ended or changed')
                os.kill(int(session['launcher_pid']), 0)
            except (OSError, ValueError, KeyError, RuntimeError):
                print('Simulator session ended; stopping the owned Drone API.', flush=True)
                raise KeyboardInterrupt
except KeyboardInterrupt:
    try:
        os.killpg(server.pid, signal.SIGINT)
        exit_code = server.wait(timeout=5)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        server.terminate()
        try:
            exit_code = server.wait(timeout=3)
        except subprocess.TimeoutExpired:
            server.kill()
            exit_code = server.wait()
raise SystemExit(exit_code)
