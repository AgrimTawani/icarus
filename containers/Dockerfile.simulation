FROM ubuntu:24.04

ARG ICARUS_GIT_REVISION=unknown
ENV ICARUS_GIT_REVISION=${ICARUS_GIT_REVISION}
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace/Icarus
COPY . .
RUN ./scripts/bootstrap --profile simulation
ENV GZ_SIM_RESOURCE_PATH=/workspace/Icarus/simulation/models
CMD ["./scripts/start-sim", "--profile", "simulation-empty"]
